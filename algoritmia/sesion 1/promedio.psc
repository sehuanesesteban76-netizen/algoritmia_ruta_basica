Algoritmo Promedi
	Definir nombre Como Caracter
	Escribir "Dime tu nombre: "
	Leer nombre
	Escribir "Vamos a sacar tu promedio de notas"
	Definir nota1,nota2,nota3,promedio Como real
	Escribir "Ingresa tu Nota 1: "
	Leer nota1
	Escribir "Ingresa tu Nota 2: "
	Leer nota2
	Escribir "Ingresa tu Nota 3: "
	Leer nota3
	
	promedio = (nota1 + nota2 + nota3) / 3
	
	Escribir nombre , " tu promedio de notas es: ", promedio
FinAlgoritmo
